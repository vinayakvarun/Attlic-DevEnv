{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/__/auth/(.*)",
      "destination": "https://gen-lang-client-0545259304.firebaseapp.com/__/auth/$1"
    },
    {
      "source": "/__/firebase/(.*)",
      "destination": "https://gen-lang-client-0545259304.firebaseapp.com/__/firebase/$1"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api/|__/auth/|__/firebase/).*)",
      "destination": "/index.html"
    }
  ]
}
